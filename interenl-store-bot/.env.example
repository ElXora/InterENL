# =====================================================
#  InterENL Store License Bot - Environment Configuration
# =====================================================
# 1. Copy this file and rename the copy to ".env"
# 2. Fill in the values below
# 3. NEVER share your .env file or commit it to GitHub
# =====================================================

# Your Discord Bot Token
# Get it from: https://discord.com/developers/applications -> Your App -> Bot -> Reset Token
BOT_TOKEN=your_bot_token_here

# Your Discord Application (Client) ID
# Get it from: https://discord.com/developers/applications -> Your App -> General Information -> Application ID
CLIENT_ID=your_application_client_id_here

# (Optional) Guild ID for instant slash command registration during development/testing.
# Leave empty to register commands globally (can take up to 1 hour to appear everywhere).
GUILD_ID=

# (Optional) Channel ID where general action logs should be posted by the bot.
LOG_CHANNEL_ID=

# (Optional) Channel ID where admins are notified about license leak / anti-nuke incidents.
ADMIN_ALERT_CHANNEL_ID=

# =====================================================
#  Owner & Admin access
# =====================================================
# The Discord User ID with full, permanent owner access.
# Change this any time — no code edits needed.
OWNER_ID=1146698011641118761

# (Optional) Extra admins configured directly here, comma-separated,
# no spaces needed around commas. These always have admin access,
# in addition to anyone added at runtime with /admin add.
# Example: ADMIN_IDS=111111111111111111,222222222222222222
ADMIN_IDS=

# =====================================================
#  Feature toggles
# =====================================================
# Flip any system on/off without touching config.json or code.
# Leave a value blank to keep whatever config/config.json already
# says (all default to "true" out of the box).
ENABLE_ECONOMY=true
ENABLE_LOOT_DROPS=true
ENABLE_DAILY=true
ENABLE_WORK=true
ENABLE_LICENSE_REWARDS=true
ENABLE_LICENSE_SYSTEM=true
ENABLE_MODERATION=true
ENABLE_ANTINUKE=true
ENABLE_LEAK_PROTECTION=true
ENABLE_TICKETS=true
ENABLE_WELCOME=true
ENABLE_LEVELING=true
ENABLE_BATTLEPASS=true
ENABLE_GAMES=true
ENABLE_CHALLENGES=true
ENABLE_GIVEAWAYS=true
ENABLE_SHOP=true
ENABLE_INVITE_TRACKING=true
ENABLE_VERIFY=true

# (Optional) Override the economy currency name/emoji shown everywhere
# (balance, pay, leaderboard, loot drops, etc.) without editing config.json.
# CURRENCY_EMOJI_NAME must match a real emoji name in your server
# (e.g. "interenlstorelogo") for the custom emoji to actually render.
CURRENCY_NAME=VSC
CURRENCY_EMOJI_NAME=interenlstorelogo

# =====================================================
#  Announcements
# =====================================================
# The channel /announce posts to. Right-click a channel in Discord
# (Developer Mode must be on) -> "Copy Channel ID" and paste it here.
# If this is wrong or the bot can't see the channel, /announce will
# tell you exactly why.
ANNOUNCE_CHANNEL_ID=1528853371757269014

# =====================================================
#  Welcome messages
# =====================================================
# The channel new-member welcome embeds get posted to.
# Right-click the channel -> "Copy Channel ID" and paste it here.
# Has no effect while ENABLE_WELCOME=false.
# Customize the message text/description in config/config.json
# under "welcome" (supports %username%, %tag%, %mention%, {member}
# and ":shortcode:" custom emoji placeholders).
WELCOME_CHANNEL_ID=

# =====================================================
#  Ticket system
# =====================================================
# The Staff and Owner roles that get pinged when a ticket is opened,
# and that can see/manage every ticket thread. Right-click the role
# in Server Settings -> Roles -> "Copy Role ID" and paste it here.
# If left blank, the bot falls back to searching for roles named
# exactly "🌟┃Staff" / "🌟┃Owner" (configurable in config/config.json),
# but setting the ID here is more reliable.
TICKET_STAFF_ROLE_ID=
TICKET_OWNER_ROLE_ID=

# =====================================================
#  Economy system
# =====================================================
# The channel where random Loot Drop messages get posted.
# Right-click the channel -> "Copy Channel ID" and paste it here.
LOOT_CHANNEL_ID=

# =====================================================
#  Leveling / XP
# =====================================================
# (Optional) A specific channel for level-up announcements.
# Leave blank to announce in whichever channel the user's
# message that triggered the level-up was sent in.
LEVELUP_CHANNEL_ID=

# =====================================================
#  Giveaways
# =====================================================
# (Optional) A channel that gets a copy of every "giveaway ended"
# result, useful as a permanent staff-facing giveaway log.
GIVEAWAY_LOG_CHANNEL_ID=

# =====================================================
#  Invite Tracking
# =====================================================
# Accounts younger than this many days when they join are flagged
# as "fake" invites instead of counting toward the inviter's total.
FAKE_ACCOUNT_AGE_DAYS=7

# =====================================================
#  Member Verification (Discord OAuth2)
# =====================================================
# /setverify posts a button that sends people through Discord's own
# OAuth2 consent page — this is NOT a bot-hosted login form, it's
# discord.com itself. Approving it redirects back to a tiny web
# server this bot runs, which then grants VERIFIED_ROLE_ID.
#
# REQUIRED ONE-TIME SETUP (outside this .env):
#  1. Discord Developer Portal -> your application -> OAuth2 ->
#     "Redirects" -> add the EXACT value of OAUTH_REDIRECT_URI below.
#  2. Discord Developer Portal -> OAuth2 -> "Client Secret" -> copy
#     it into DISCORD_CLIENT_SECRET below. Treat it like a password —
#     never commit it or share it.
#  3. This server needs to actually be reachable at OAUTH_REDIRECT_URI —
#     that means a public port/domain (a reverse proxy, tunnel, or
#     hosting provider that exposes VERIFY_PORT), NOT just running
#     `node index.js` on a machine with no public networking. The
#     bot's normal Discord connection doesn't need this — only the
#     OAuth2 callback step does.
#
# The Discord Application (Client) ID above (CLIENT_ID) is reused
# as the OAuth2 client ID — no separate variable needed for that part.
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/auth/discord/callback
VERIFY_PORT=3000
# The role granted on successful verification. Right-click the role
# in Server Settings -> Roles -> "Copy Role ID" and paste it here.
VERIFIED_ROLE_ID=
